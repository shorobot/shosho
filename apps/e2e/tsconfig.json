{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["specs/**/*.ts", "helpers/**/*.ts", "scripts/**/*.ts", "fixtures.ts", "playwright.config.ts"]
}
