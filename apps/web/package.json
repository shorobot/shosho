    "test:e2e": "playwright test",
    "test:integration": "SHOSHO_INTEGRATION=1 vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.8",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
