{
  "name": "@shosho/web",
  "version": "0.1.0",
  "private": true,
  "description": "SHOSHO guest site: menu, product, cart, checkout, order tracking (Next.js App Router).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
