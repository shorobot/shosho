# apps/web — copy to .env.local (never commit the real file).
# Supabase project the guest site talks to with the anon key (RLS-filtered, guest checkout, no auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of the site (canonical URLs, metadata). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Data layer: "supabase" (default) or "mock" (in-memory seed data, no backend needed — see README).
NEXT_PUBLIC_API=supabase
