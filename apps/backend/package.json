{
  "name": "@shosho/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SHOSHO Supabase project: migrations, seed, RLS, RPCs, generated types and integration tests.",
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --include-seed",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@types/node": "^22.10.0",
    "supabase": "^2.40.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
