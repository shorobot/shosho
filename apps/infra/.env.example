# apps/infra — used by docker-compose.yml (local) and docker-compose.staging.yml (server).
# Copy to apps/infra/.env. NEVER commit the real file. On the server this file is rendered by CI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ANTHROPIC_API_KEY=
# web container (apps/web) — same Supabase project, public names; rendered by CI on the server
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
