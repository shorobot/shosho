# apps/infra — used by docker-compose.yml (local) and docker-compose.staging.yml (server).
# Copy to apps/infra/.env. NEVER commit the real file. On the server this file is rendered by CI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ANTHROPIC_API_KEY=
# web (apps/web) and backoffice (apps/backoffice) containers — same Supabase project, public names;
# rendered by CI on the server. The back-office uses the anon key too (staff session + RLS), never the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
